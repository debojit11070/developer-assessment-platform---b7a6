PORT=5000
NODE_ENV=development

# PostgreSQL (Neon recommended for serverless)
# Local Postgres example:
#   postgresql://user:password@localhost:5432/dev_assessment?schema=public
# Neon example (from the Neon dashboard, "Connection details" → pooled):
#   postgresql://neondb_owner:npg_SGD1fxW9RpVO@ep-empty-leaf-a5ck3ed7-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL="postgresql://neondb_owner:npg_SGD1fxW9RpVO@ep-empty-leaf-a5ck3ed7-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Redis (optional)
REDIS_URL="redis://default:password@localhost:6379"

# Auth
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Stripe
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

# Frontend / app URLs (used for Stripe return URLs)
APP_BASE_URL="http://localhost:5000"
