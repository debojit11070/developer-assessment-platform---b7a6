                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/AiAssessmentItem"
                          }
                        },
                        "personalized": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
