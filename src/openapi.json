      "get": {
        "tags": [
          "AI"
        ],
        "summary": "Recommended assessments",
        "description": "Tag/difficulty scoring (no LLM). Authentication is optional: a signed-in CANDIDATE gets results personalized from their past attempts (`personalized: true`) and already-attempted assessments are excluded. Rate limit: 60 / min.",
